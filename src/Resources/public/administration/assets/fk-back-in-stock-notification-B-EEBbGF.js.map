{% block sw_fk_back_in_stock_notification_log %}
<sw-card
    class="sw-fk-back-in-stock-notification-log"
    :title="$tc('sw-fk-back-in-stock-notification.log.title')"
    position-identifier="sw-fk-back-in-stock-notification-log"
    :is-loading="isLoading">

    <template #toolbar>
        <div class="sw-fk-back-in-stock-notification-log__toolbar">
            <sw-single-select
                v-model:value="level"
                size="small"
                :options="levelOptions.map(o => ({ value: o.value, label: $tc(o.label) }))"
                @update:value="load" />
            <sw-simple-search-field
                v-model:value="term"
                size="small"
                variant="form"
                @search-term-change="load" />
            <mt-button variant="secondary" size="small" @click="load">
                {{ $tc('sw-fk-back-in-stock-notification.log.refresh') }}
            </mt-button>
            <mt-button
                :variant="autoRefresh ? 'primary' : 'secondary'"
                size="small"
                @click="toggleAutoRefresh">
                {{ $tc('sw-fk-back-in-stock-notification.log.liveTail') }}
            </mt-button>
            <sw-single-select
                v-if="autoRefresh"
                v-model:value="refreshSeconds"
                size="small"
                :options="refreshOptions" />
            <mt-button variant="secondary" size="small" @click="onDownload('txt')">TXT</mt-button>
            <mt-button variant="secondary" size="small" @click="onDownload('csv')">CSV</mt-button>
        </div>
    </template>

    {% block sw_fk_back_in_stock_notification_log_status %}
    <div
        v-if="autoRefresh || lastUpdated"
        class="sw-fk-back-in-stock-notification-log__status">
        <sw-label v-if="autoRefresh" variant="info" appearance="pill" size="small">
            {{ $tc('sw-fk-back-in-stock-notification.log.liveTail') }} &middot; {{ refreshSeconds }}s
        </sw-label>
        <span v-if="lastUpdated" class="sw-fk-back-in-stock-notification-log__updated">
            {{ $tc('sw-fk-back-in-stock-notification.log.updated') }}: {{ lastUpdatedLabel }}
        </span>
    </div>
    {% endblock %}

    {% block sw_fk_back_in_stock_notification_log_body %}
    <div class="sw-fk-back-in-stock-notification-log__body">
        <p v-if="!entries.length" class="sw-fk-back-in-stock-notification-log__empty">
            {{ $tc('sw-fk-back-in-stock-notification.log.empty') }}
        </p>
        <ul v-else class="sw-fk-back-in-stock-notification-log__list">
            <li v-for="(entry, index) in entries" :key="index" class="sw-fk-back-in-stock-notification-log__row">
                <sw-label v-if="entry.level" :variant="levelVariant(entry.level)" appearance="pill" size="small">
                    {{ entry.level }}
                </sw-label>
                <span class="sw-fk-back-in-stock-notification-log__time">{{ entry.datetime }}</span>
                <span class="sw-fk-back-in-stock-notification-log__message">{{ entry.message }}</span>
            </li>
        </ul>
    </div>
    {% endblock %}
</sw-card>
{% endblock %}
