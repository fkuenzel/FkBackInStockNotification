<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <!--
        Storefront-only services. Loaded conditionally from the plugin base class
        (FkBackInStockNotification::build) so the plugin also boots on headless
        installations without the Storefront bundle.
    -->
    <services>
        <defaults autowire="true" autoconfigure="true" public="false"/>

        <service id="Fkuenzel\FkBackInStockNotification\Storefront\Subscriber\ProductPageSubscriber">
            <argument type="service" id="Fkuenzel\FkBackInStockNotification\Service\BackInStockNotificationService"/>
            <tag name="kernel.event_subscriber"/>
        </service>
        <service id="Fkuenzel\FkBackInStockNotification\Controller\Storefront\NotificationController" public="true">
            <argument type="service" id="Fkuenzel\FkBackInStockNotification\Service\BackInStockNotificationService"/>
            <argument type="service" id="Shopware\Storefront\Page\GenericPageLoader"/>
            <argument type="service" id="fk_back_in_stock_notification.logger"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>
        <service id="Fkuenzel\FkBackInStockNotification\Controller\Storefront\AccountNotificationController" public="true">
            <argument type="service" id="Fkuenzel\FkBackInStockNotification\Service\BackInStockNotificationService"/>
            <argument type="service" id="fk_back_in_stock_notification.repository"/>
            <argument type="service" id="Shopware\Storefront\Page\GenericPageLoader"/>
            <argument type="service" id="fk_back_in_stock_notification.logger"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>
    </services>
</container>
