<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Storefront routes. Imported conditionally from the plugin base class
    (BackInStockNotification::configureRoutes) only when the Storefront bundle
    is installed, so the attribute loader never reflects on the storefront
    controllers on a headless installation.
-->
<routes xmlns="http://symfony.com/schema/routing"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/routing https://symfony.com/schema/routing/routing-1.0.xsd">

    <import resource="../../Controller/Storefront/" type="attribute"/>
</routes>
