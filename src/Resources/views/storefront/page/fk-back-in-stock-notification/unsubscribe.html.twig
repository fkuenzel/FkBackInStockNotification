{% sw_extends '@Storefront/storefront/base.html.twig' %}

{% block base_main_inner %}
    <div class="fk-back-in-stock-notification-unsubscribe container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                {% if unsubscribeMode == 'confirm' %}
                    {% block page_fk_back_in_stock_notification_unsubscribe_confirm %}
                        <h1 class="h4">{{ 'backInStockNotification.unsubscribe.confirmTitle'|trans|sw_sanitize }}</h1>
                        <p>{{ 'backInStockNotification.unsubscribe.confirmText'|trans|sw_sanitize }}</p>
                        <form action="{{ path('frontend.fk-back-in-stock-notification.unsubscribe.confirm', { token: unsubscribeToken }) }}"
                              method="post"
                              class="fk-back-in-stock-notification-unsubscribe-form">
                            <button type="submit" class="btn btn-primary">
                                {{ 'backInStockNotification.unsubscribe.confirmButton'|trans|sw_sanitize }}
                            </button>
                            <a href="{{ path('frontend.home.page') }}" class="btn btn-link">
                                {{ 'backInStockNotification.unsubscribe.backHome'|trans|sw_sanitize }}
                            </a>
                        </form>
                    {% endblock %}
                {% elseif unsubscribeMode == 'success' %}
                    {% block page_fk_back_in_stock_notification_unsubscribe_success %}
                        <div class="alert alert-success" role="status">
                            <h1 class="h4">{{ 'backInStockNotification.unsubscribe.successTitle'|trans|sw_sanitize }}</h1>
                            <p class="mb-0">{{ 'backInStockNotification.unsubscribe.successText'|trans|sw_sanitize }}</p>
                        </div>
                        <a href="{{ path('frontend.home.page') }}" class="btn btn-primary">
                            {{ 'backInStockNotification.unsubscribe.backHome'|trans|sw_sanitize }}
                        </a>
                    {% endblock %}
                {% else %}
                    {% block page_fk_back_in_stock_notification_unsubscribe_error %}
                        <div class="alert alert-warning" role="alert">
                            <h1 class="h4">{{ 'backInStockNotification.unsubscribe.errorTitle'|trans|sw_sanitize }}</h1>
                            <p class="mb-0">{{ 'backInStockNotification.unsubscribe.errorText'|trans|sw_sanitize }}</p>
                        </div>
                        <a href="{{ path('frontend.home.page') }}" class="btn btn-primary">
                            {{ 'backInStockNotification.unsubscribe.backHome'|trans|sw_sanitize }}
                        </a>
                    {% endblock %}
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
